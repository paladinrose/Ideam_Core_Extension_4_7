<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="SourceBar" style="flex-direction: row; align-items: flex-start;">
        <ui:Foldout text="Ray" name="ShowRay" value="false">
            <ui:TextField picking-mode="Ignore" label="Name" value="Sensor Ray" text="Sensor Ray" name="NameField" />
            <Ideam.Unity.UI.LayersDrop name="LayerMask" Label="Layer Mask" AllowMultiSelect="true" />
            <ui:VisualElement name="BoolBar" style="flex-direction: row;">
                <ui:Toggle label="Cast On Start" name="CastOnStart" />
                <ui:Toggle label="Cast On Active" name="CastOnActive" />
            </ui:VisualElement>
            <Ideam.Unity.UI.ObjectSelectorField name="OriginSelector" Label="Origin Transform" />
            <ui:VisualElement name="LengthBar" style="flex-direction: row;">
                <ui:FloatField label="Length" value="10" name="LengthField" />
                <ui:Toggle label="Scale to Origin" name="ScaleLengthField" />
            </ui:VisualElement>
            <ui:Vector3Field label="Origin" name="OriginField" />
            <ui:EnumField label="Origin Space" type="UnityEngine.Space, UnityEngine.CoreModule" name="OriginSpaceDrop" />
            <ui:Vector3Field label="Direction" name="DirectionField" />
            <ui:EnumField label="Direction Space" type="UnityEngine.Space, UnityEngine.CoreModule" name="DirectionSpaceDrop" />
        </ui:Foldout>
        <ui:Button name="RemoveRay" class="icon remove" />
    </ui:VisualElement>
</ui:UXML>
